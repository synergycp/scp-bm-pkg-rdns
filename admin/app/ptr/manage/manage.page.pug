doctype html

.row
  .col-md-8
    form.panel.panel-default(
        ng-submit="vm.save()",
        ng-class="vm.loader.class"
    )
        .loader
        .panel-heading
            h3.panel-title
                span(translate="pkg.rdns.admin.manage.TITLE")
                small(ng-if="vm.server.name" style="margin-left: 8px" ng-bind="vm.server.name")
            .btn-group.btn-group-xs.pull-right
                a.btn.btn-default(ui-sref="app.hardware.server.view.manage({id: vm.serverId})")
                    span.fa.fa-arrow-left
                    span(translate="pkg.rdns.admin.manage.BACK" style="margin-left: 4px")
        .panel-body
            table.table(ng-if="vm.ptrs.length")
                thead
                    tr
                        th(translate="pkg.rdns.admin.ptr.form.list.ip.LABEL")
                        th(translate="pkg.rdns.admin.ptr.form.list.ptr.LABEL")
                tbody
                    tr(
                        ng-repeat="ptr in vm.ptrs"
                    )
                        td.v-mid(ng-bind="ptr.ip")
                        td
                            input.form-control(
                            ng-model="ptr.ptr",
                            ng-change="vm.change(ptr)"
                            )
            span(
                ng-if="!vm.ptrs.length"
                translate="pkg.rdns.admin.ptr.alert.alert-info"
            )
        .panel-footer.clearfix(ng-if="vm.ptrs.length")
            .pull-right
                button.btn.btn-primary(translate="pkg.rdns.admin.ptr.form.SAVE")
